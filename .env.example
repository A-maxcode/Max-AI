APP_NAME=Max-AI
APP_ENV=development
APP_PORT=8000
DB_PORT=5432

POSTGRES_DB=maxai
POSTGRES_USER=maxai
POSTGRES_PASSWORD=replace-with-a-random-hex-password
DATABASE_URL=postgresql+psycopg://maxai:replace-with-a-random-hex-password@localhost:5432/maxai

MODEL_SERVER_URL=http://model-server:8080
MODEL_NAME=auto
MODEL_SYSTEM_PROMPT=You are a helpful, clear, and friendly assistant.
MODEL_PATH=/models/smollm2-1.7b-instruct-q4_k_m.gguf
MODEL_CONTEXT_LENGTH=2048
MODEL_MAX_TOKENS=256
MODEL_THREADS=2
MODEL_BATCH_SIZE=128
MODEL_GPU_LAYERS=0
MODEL_TIMEOUT_SECONDS=180
MODEL_TEMPERATURE=0.7

ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOW_REGISTRATION=true
FRONTEND_ORIGINS=http://localhost:8000
AUTH_RATE_LIMIT=10
CHAT_RATE_LIMIT=30
