APP_NAME=Max-AI
APP_ENV=development
APP_PORT=8000
DB_PORT=5432
MODEL_PORT=8080

POSTGRES_DB=maxai
POSTGRES_USER=maxai
POSTGRES_PASSWORD=replace-with-a-random-hex-password
DATABASE_URL=postgresql+psycopg://maxai:replace-with-a-random-hex-password@localhost:5432/maxai

MODEL_SERVER_URL=http://127.0.0.1:8080
MODEL_NAME=auto
MODEL_SYSTEM_PROMPT=You are a helpful, clear, and friendly assistant.
MODEL_FILE=qwen2.5-3b-instruct-q4_k_m.gguf
MODEL_CONTEXT_LENGTH=4096
MODEL_MAX_TOKENS=512
MODEL_GPU_LAYERS=0
MODEL_TIMEOUT_SECONDS=120
MODEL_TEMPERATURE=0.7

ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOW_REGISTRATION=true
FRONTEND_ORIGINS=http://localhost:8000
AUTH_RATE_LIMIT=10
CHAT_RATE_LIMIT=30
